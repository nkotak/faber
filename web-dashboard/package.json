{
  "name": "faber-web",
  "version": "0.1.0",
  "description": "Editorial-meets-terminal web dashboard for the faber pipeline. Complementary to the Go TUI; neither touches the other.",
  "type": "module",
  "private": true,
  "bin": {
    "faber-web": "./bin/faber-web.mjs"
  },
  "scripts": {
    "dev": "concurrently -n server,app -c cyan,magenta \"npm run dev:server\" \"npm run dev:app\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:app": "vite",
    "build": "vite build",
    "start": "node server/index.mjs",
    "faber-web": "node bin/faber-web.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.2.0",
    "chokidar": "^4.0.3",
    "dompurify": "^3.3.0",
    "fastify": "^5.5.0",
    "mammoth": "^1.8.0",
    "markdown-it": "^14.1.0",
    "open": "^11.0.0",
    "pdf-parse": "^1.1.1",
    "yaml": "^2.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@fontsource/gloock": "^5.2.8",
    "@fontsource/spectral": "^5.2.8",
    "@fontsource/fragment-mono": "^5.2.8",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.14.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.2.1"
  }
}
